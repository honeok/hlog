<dialog id="search-dialog" data-search-dialog aria-label="搜索文章">
  <form data-search-form>
    <input type="search" data-search-input placeholder="搜索文章" autocomplete="off" aria-label="搜索文章" />
    <div class="search-results" data-search-results aria-live="polite" hidden></div>
  </form>
</dialog>

<script>
  type PagefindResult = { url: string; meta: { title: string } }
  type Pagefind = {
    debouncedSearch: (query: string) => Promise<{
      results: { data: () => Promise<PagefindResult> }[]
    } | null>
  }

  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]')
  const form = dialog?.querySelector<HTMLFormElement>('[data-search-form]')
  const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]')
  const results = dialog?.querySelector<HTMLElement>('[data-search-results]')
  let pagefindPromise: Promise<Pagefind> | undefined
  let searchId = 0

  const loadPagefind = () => {
    // Pagefind 在 Astro 构建后生成, 因此需保留此导入供浏览器在运行时加载
    const modulePath = '/pagefind/pagefind.js'
    pagefindPromise ??= import(/* @vite-ignore */ modulePath).catch((error) => {
      pagefindPromise = undefined
      throw error
    })
    return pagefindPromise
  }

  const search = async () => {
    // 搜索和清空共用序号, 使旧请求在后续异步检查中失效
    const requestId = ++searchId
    if (!input || !results) return
    const query = input.value.trim()
    results.replaceChildren()
    results.hidden = true
    if (!query || !dialog?.open) return

    try {
      const pagefind = await loadPagefind()
      if (requestId !== searchId || !dialog.open) return
      const response = await pagefind.debouncedSearch(query)
      if (!response || requestId !== searchId || !dialog.open) return
      // 仅获取默认排名前 8 条的数据, 避免加载其余结果片段
      const matches = await Promise.all(response.results.slice(0, 8).map((result) => result.data()))
      if (requestId !== searchId || !dialog.open) return

      const content = document.createDocumentFragment()

      for (const { meta, url } of matches) {
        const link = document.createElement('a')
        link.href = url
        link.textContent = meta.title
        content.append(link)
      }

      if (!matches.length) {
        const empty = document.createElement('p')
        empty.textContent = '没有匹配的文章'
        content.append(empty)
      }

      results.append(content)
      results.hidden = false
    } catch (error) {
      if (requestId !== searchId || !dialog?.open) return
      console.error('Failed to search with Pagefind:', error)
      const message = document.createElement('p')
      message.textContent = '搜索暂时不可用，请稍后重试'
      results.replaceChildren(message)
      results.hidden = false
    }
  }

  document.querySelector('[data-search-trigger]')?.addEventListener('click', () => {
    dialog?.showModal()
    requestAnimationFrame(() => input?.focus())
  })
  input?.addEventListener('input', () => void search())
  input?.addEventListener('keydown', (event) => {
    // 组合输入期间将 Escape 留给输入法, 避免提前关闭弹窗
    if (event.isComposing || event.key !== 'Escape') return
    event.preventDefault()
    dialog?.close()
  })
  form?.addEventListener('submit', (event) => {
    event.preventDefault()
    results?.querySelector<HTMLAnchorElement>('a')?.click()
  })
  dialog?.addEventListener('click', ({ target }) => target === dialog && dialog.close())
  dialog?.addEventListener('close', () => {
    if (input) input.value = ''
    void search()
  })
</script>

<style>
  dialog {
    inline-size: min(32rem, calc(100% - 2rem));
    max-inline-size: none;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-background);
    color: var(--color-text);
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 18%);
    overflow: hidden;
  }

  dialog::backdrop {
    background: rgb(0 0 0 / 28%);
    backdrop-filter: blur(4px);
  }

  form {
    margin: 0;
  }

  input {
    inline-size: 100%;
    padding: 1rem 1.125rem;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-text-strong);
    font: inherit;
  }

  input::placeholder {
    color: var(--color-text-faint);
  }

  .search-results {
    max-block-size: min(22rem, 50vh);
    padding: 0.375rem;
    border-block-start: 1px solid var(--color-border);
    overflow-y: auto;
  }

  .search-results > :global(a) {
    display: block;
    padding: 0.625rem 0.75rem;
    border-radius: 0.375rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .search-results > :global(a:hover),
  .search-results > :global(a:focus-visible) {
    background: var(--color-surface);
    color: var(--color-text-strong);
    outline: 0;
  }

  .search-results > :global(p) {
    margin: 0;
    padding: 0.75rem;
    color: var(--color-text-faint);
    text-align: center;
  }
</style>
