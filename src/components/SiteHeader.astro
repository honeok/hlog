---
import SiteActions from '@components/SiteActions.astro'
import { NAV_ITEMS, SITE } from '../config'
---

<header data-priority-header>
  <a href="/">
    <span>{SITE.title}</span>
  </a>
  <nav aria-label="Primary navigation">
    <ul class="nav-list">
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
      <li class="nav-overflow" hidden>
        <button
          class="nav-overflow-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="site-nav-overflow"
          aria-label="打开更多导航"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16"></path>
            <path d="M4 12h16"></path>
            <path d="M4 18h16"></path>
          </svg>
        </button>
        <ul class="nav-overflow-menu" id="site-nav-overflow" hidden></ul>
      </li>
    </ul>
  </nav>
  <SiteActions />
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-priority-header]')

  if (header) {
    const nav = header.querySelector<HTMLElement>('nav')!
    const navList = header.querySelector<HTMLElement>('.nav-list')!
    const overflow = header.querySelector<HTMLElement>('.nav-overflow')!
    const overflowToggle = header.querySelector<HTMLButtonElement>('.nav-overflow-toggle')!
    const overflowMenu = header.querySelector<HTMLElement>('.nav-overflow-menu')!
    let animationFrameId = 0

    const setMenuOpen = (open: boolean) => {
      overflowMenu.hidden = !open
      overflowToggle.setAttribute('aria-expanded', String(open))
      overflowToggle.setAttribute('aria-label', open ? '关闭更多导航' : '打开更多导航')
    }

    const navFits = () => navList.scrollWidth <= nav.clientWidth + 1 && header.scrollWidth <= header.clientWidth + 1

    const updateNavigation = () => {
      setMenuOpen(false)

      while (overflowMenu.firstElementChild) {
        const item = overflowMenu.firstElementChild
        navList.insertBefore(item, overflow)
        overflow.hidden = overflowMenu.childElementCount === 0

        if (!navFits()) {
          overflowMenu.prepend(item)
          overflow.hidden = false
          break
        }
      }

      while (!navFits()) {
        const item = overflow.previousElementSibling
        if (!item) break
        overflowMenu.prepend(item)
        overflow.hidden = false
      }
    }

    const scheduleNavigationUpdate = () => {
      if (animationFrameId) return
      animationFrameId = window.requestAnimationFrame(() => {
        animationFrameId = 0
        updateNavigation()
      })
    }

    overflowToggle.addEventListener('click', () => setMenuOpen(overflowMenu.hidden !== false))

    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !overflow.contains(event.target)) setMenuOpen(false)
    })

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || overflowMenu.hidden) return
      setMenuOpen(false)
      overflowToggle.focus()
    })

    const resizeObserver = new ResizeObserver(scheduleNavigationUpdate)
    resizeObserver.observe(header)
    scheduleNavigationUpdate()
    document.fonts.ready.then(scheduleNavigationUpdate)
  }
</script>

<style>
  /* 顶部导航到页面顶边小屏留 16px, 768px 起留 32px, 导航到正文留 48px */
  header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-block: 1rem 3rem;
  }

  header > a {
    display: inline-flex;
    flex: none;
    align-items: center;
    color: var(--color-text-strong);
    font-size: 1.125rem;
    font-style: italic;
    font-weight: 700;
    font-synthesis: style;
    letter-spacing: 0.04em;
    text-transform: none;
    white-space: nowrap;
  }

  nav {
    min-inline-size: 0;
  }

  .nav-list {
    display: flex;
    gap: 0.25rem 0.9375rem;
    margin: 0;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }

  .nav-list > li {
    flex: none;
  }

  a {
    display: block;
    text-decoration: none;
    text-transform: lowercase;
    transition: color 160ms ease;
  }

  .nav-overflow {
    position: relative;
  }

  .nav-overflow:not([hidden]) {
    display: flex;
  }

  .nav-overflow-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    font: inherit;
    transition: color 160ms ease;
  }

  .nav-overflow-toggle svg {
    display: block;
    width: 1em;
    height: 1em;
    flex: none;
  }

  .nav-overflow-menu {
    position: absolute;
    z-index: 20;
    inset-block-start: calc(100% + 0.5rem);
    inset-inline-start: 50%;
    display: grid;
    inline-size: max-content;
    margin: 0;
    padding: 0.375rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 18%);
    list-style: none;
    transform: translateX(-50%);
  }

  .nav-overflow-menu[hidden] {
    display: none;
  }

  .nav-overflow-menu a {
    padding: 0.375rem 0.625rem;
    border-radius: 0.25rem;
    text-align: center;
  }

  a:hover,
  a:focus-visible,
  .nav-overflow-toggle:hover,
  .nav-overflow-toggle:focus-visible {
    color: var(--color-text-strong);
  }

  a:focus-visible,
  .nav-overflow-toggle:focus-visible {
    border-radius: 0.15rem;
    outline: 1px dotted currentColor;
    outline-offset: 2px;
  }

  @media (max-width: 39.999rem) {
    header {
      gap: 0.625rem;
    }

    .nav-list {
      column-gap: 0.46875rem;
    }
  }

  /* 768px 起, 顶部导航距离页面顶边 32px */
  @media (min-width: 48rem) {
    header {
      margin-block-start: 2rem;
    }
  }
</style>
