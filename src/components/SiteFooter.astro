---
import { FILING, SITE } from '../config'

const year = new Date().getFullYear()
const filingParts = FILING?.label.split(/(\d+)/) ?? []
const filingHref = FILING?.href ?? ''
---

<footer class="page-container" data-has-filing={FILING ? '' : undefined}>
  <span>
    © {year}{' '}{SITE.author} · <a
      href="https://creativecommons.org/licenses/by-nc-sa/4.0"
      target="_blank"
      rel="license noopener">CC BY-NC-SA 4.0</a
    >
  </span>
  {
    FILING && (
      <span>
        {filingParts.map((part) =>
          /^\d+$/.test(part) ? (
            <a href={filingHref} target="_blank" rel="noopener">
              {part}
            </a>
          ) : (
            part
          ),
        )}
      </span>
    )
  }
</footer>

<style>
  footer {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: flex-start;
    margin-block-start: auto;
    /* 正文结束到版权信息之间的间距, 小屏为 24px */
    padding-block-start: 1.5rem;
    /* 版权信息到页面最底边的间距, 小屏为 16px, 安全区更大时优先使用安全区 */
    padding-block-end: max(1rem, env(safe-area-inset-bottom));
    color: var(--color-text-muted);
    font-size: 0.92rem;
    text-align: start;
  }

  footer[data-has-filing] {
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  /* 640px 起, 页面底部信息自身上方留 40px */
  @media (min-width: 40rem) {
    footer {
      padding-block-start: 2.5rem;
    }
  }

  /* 768px 起, 页面底部信息自身上方留 56px, 信息到页面底边至少留 32px */
  @media (min-width: 48rem) {
    footer {
      padding-block-start: 3.5rem;
      padding-block-end: max(2rem, env(safe-area-inset-bottom));
    }
  }

  footer a {
    color: inherit;
    text-decoration-color: var(--color-border);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  footer a:hover {
    text-decoration-color: currentColor;
  }
</style>
